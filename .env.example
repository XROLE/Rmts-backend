# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Verification: Email & WhatsApp (both mocked with a fixed code 7530, no external provider)

# SMTP (support email notifications). For Gmail, SMTP_USER is the sending
# Gmail address and SMTP_PASS is a Google App Password (needs 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=urbannest.quick.support@gmail.com
SMTP_PASS=your-app-password
SUPPORT_EMAIL=urbannest.quick.support@gmail.com

# Paystack (ambassador payments)
# Secret key for server-to-server API calls. Never expose the public key here.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
# Base API URL (override for local Paystack mocking/proxies).
PAYSTACK_BASE_URL=https://api.paystack.co
# Ambassador commission as a percentage of each paid roommate payment.
COMMISSION_PERCENT=10
# Absolute URL Paystack redirects the roommate to after payment.
PAYMENT_RETURN_URL=https://your-frontend.example.com/payment/complete
# Minimum naira amount an ambassador can withdraw.
MIN_WITHDRAWAL_AMOUNT=1000
# Maximum naira amount an ambassador can withdraw per request.
MAX_WITHDRAWAL_AMOUNT=5000
# When true, verify/save bank using Paystack test bank code 001.
USE_PAYSTACK_TEST_BANK=true
# When true, approving a withdrawal simulates a successful Paystack transfer
# (for starter businesses where live transfers are disabled). Requires the
# Paystack wallet balance to cover the withdrawal amount.
SIMULATE_PAYSTACK_TRANSFERS=true

# WhatsApp Business Cloud API (interactive Flows: onboarding + match decisions)
# System User access token with whatsapp_business_messaging and
# whatsapp_business_management permissions, scoped to the WABA.
WHATSAPP_ACCESS_TOKEN=your-system-user-token
# The business phone number ID messages are sent FROM.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Meta app secret, used to verify the webhook signature (x-hub-signature-256).
WHATSAPP_APP_SECRET=your-app-secret
# Token returned during webhook verification handshake (GET /webhook).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
# Graph API version used for HTTP calls.
WHATSAPP_API_VERSION=v21.0
# IDs of the published flows (upload flows/onboarding_flow.json,
# flows/match_decision_flow.json and flows/registration_flow.json via Account
# Tools -> Flows, then paste IDs).
WHATSAPP_FLOW_ONBOARDING_ID=your-onboarding-flow-id
WHATSAPP_FLOW_MATCH_ID=your-match-flow-id
WHATSAPP_FLOW_REGISTRATION_ID=your-registration-flow-id
# One-time fee charged via Paystack when a user accepts a match.
WHATSAPP_MATCH_PAYMENT_AMOUNT_NGN=2000
# Base URL of the replacement-match form sent after an unlock.
REPLACEMENT_FORM_BASE_URL=https://roommate.ng/request-replacement