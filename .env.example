# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Verification: Email & WhatsApp (both mocked with a fixed code 7530, no external provider)

# SMTP (support email notifications). For Gmail, SMTP_USER is the sending
# Gmail address and SMTP_PASS is a Google App Password (needs 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=urbannest.quick.support@gmail.com
SMTP_PASS=your-app-password
SUPPORT_EMAIL=urbannest.quick.support@gmail.com

# Paystack (ambassador payments)
# Secret key for server-to-server API calls. Never expose the public key here.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
# Base API URL (override for local Paystack mocking/proxies).
PAYSTACK_BASE_URL=https://api.paystack.co
# Ambassador commission as a percentage of each paid roommate payment.
COMMISSION_PERCENT=10
# Absolute URL Paystack redirects the roommate to after payment.
PAYMENT_RETURN_URL=https://your-frontend.example.com/payment/complete
# Minimum naira amount an ambassador can withdraw.
MIN_WITHDRAWAL_AMOUNT=1000
# Maximum naira amount an ambassador can withdraw per request.
MAX_WITHDRAWAL_AMOUNT=5000
# When true, verify/save bank using Paystack test bank code 001.
USE_PAYSTACK_TEST_BANK=true
# When true, approving a withdrawal simulates a successful Paystack transfer
# (for starter businesses where live transfers are disabled). Requires the
# Paystack wallet balance to cover the withdrawal amount.
SIMULATE_PAYSTACK_TRANSFERS=true

# WhatsApp Business Cloud API (interactive Flows: onboarding + match decisions)
# System User access token with whatsapp_business_messaging and
# whatsapp_business_management permissions, scoped to the WABA.
WHATSAPP_ACCESS_TOKEN=your-system-user-token
# The business phone number ID messages are sent FROM.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Meta app secret, used to verify the webhook signature (x-hub-signature-256).
WHATSAPP_APP_SECRET=your-app-secret
# Token returned during webhook verification handshake (GET /webhook).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
# Graph API version used for HTTP calls.
WHATSAPP_API_VERSION=v21.0
# IDs of the published flows (upload flows/onboarding_flow.json,
# flows/match_decision_flow.json and flows/registration_flow.json via Account
# Tools -> Flows, then paste IDs).
WHATSAPP_FLOW_ONBOARDING_ID=your-onboarding-flow-id
WHATSAPP_FLOW_MATCH_ID=your-match-flow-id
WHATSAPP_FLOW_REGISTRATION_ID=your-registration-flow-id
# Registration invitation channel sent when a user first messages the number:
#   flow     -> interactive registration Flow (requires a PUBLISHED flow)
#   template -> approved message template (no URL, no account created yet)
# Use 'template' until the Flow is published, then flip back to 'flow'.
WHATSAPP_REGISTRATION_CHANNEL=flow
# Approved template to send in template mode.
WHATSAPP_REGISTRATION_TEMPLATE_NAME=hello_world
WHATSAPP_REGISTRATION_TEMPLATE_LANG=en_US
# Number of {{N}} body placeholders to fill with the user's first name (0 = none).
WHATSAPP_REGISTRATION_TEMPLATE_PARAMS=0
# The business WhatsApp number (international, no "+") the website's wa.me link
# points to; also the number inbound text messages arrive on to trigger the
# registration Flow.
WHATSAPP_BUSINESS_PHONE_NUMBER=2348012345678
# One-time fee charged via Paystack when a user accepts a match.
WHATSAPP_MATCH_PAYMENT_AMOUNT_NGN=2000
# Base URL of the replacement-match form sent after an unlock.
REPLACEMENT_FORM_BASE_URL=https://roommate.ng/request-replacement

# Sido — Roommates NG WhatsApp AI assistant (OpenAI)
# Sido engages free-form text conversations once a user's 24-hour window is
# open, and soft-handsoff to a human agent when asked. Sido replaces the
# automatic registration greeting; it only pushes the registration form when
# the user asks for it. Set SIDO_BOT_ENABLED=false to fall back to the legacy
# auto-send greeting (requires WHATSAPP_REGISTRATION_CHANNEL + template above).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=300
SIDO_BOT_ENABLED=true
# Maximum number of past chat messages fed to the model as context per reply.
SIDO_MAX_HISTORY=30
# Email subject prefix used when Sido flags a chat for a human agent.
SIDO_HANDOVER_SUBJECT=WhatsApp handover
# URL the "Create your profile" button sends users to (website registration).
SIDO_REGISTRATION_URL=https://urban-nest-tawny.vercel.app/
# When true, a human handover pauses Sido for that phone until POST /bot/resume
# (or a stale handover auto-resumes). Keep false while Sido should keep replying.
SIDO_HANDOVER_PAUSE_BOT=false
# Stale handovers auto-resume the bot after this many hours.
SIDO_HANDOVER_AUTO_RESUME_HOURS=24

# welcome_to_roommate_ng confirmation template (sent when a profile is created
# via POST /profiles, then bot/human confirm via its quick-reply buttons).
WHATSAPP_WELCOME_TEMPLATE_NAME=welcome_to_roommate_ng
WHATSAPP_WELCOME_TEMPLATE_LANG=en_US
WHATSAPP_WELCOME_TEMPLATE_ENABLED=true