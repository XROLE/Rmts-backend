# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Verification: Email & WhatsApp (both mocked with a fixed code 7530, no external provider)

# SMTP (support email notifications). For Gmail, SMTP_USER is the sending
# Gmail address and SMTP_PASS is a Google App Password (needs 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=urbannest.quick.support@gmail.com
SMTP_PASS=your-app-password
SUPPORT_EMAIL=urbannest.quick.support@gmail.com

# Paystack (ambassador payments)
# Secret key for server-to-server API calls. Never expose the public key here.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
# Base API URL (override for local Paystack mocking/proxies).
PAYSTACK_BASE_URL=https://api.paystack.co
# Ambassador commission as a percentage of each paid roommate payment.
COMMISSION_PERCENT=10
# Absolute URL Paystack redirects the roommate to after payment.
PAYMENT_RETURN_URL=https://your-frontend.example.com/payment/complete
# Minimum naira amount an ambassador can withdraw.
MIN_WITHDRAWAL_AMOUNT=1000
# Maximum naira amount an ambassador can withdraw per request.
MAX_WITHDRAWAL_AMOUNT=5000
# When true, verify/save bank using Paystack test bank code 001.
USE_PAYSTACK_TEST_BANK=true
# When true, approving a withdrawal simulates a successful Paystack transfer
# (for starter businesses where live transfers are disabled). Requires the
# Paystack wallet balance to cover the withdrawal amount.
SIMULATE_PAYSTACK_TRANSFERS=true