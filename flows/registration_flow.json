{
  "version": "6.0",
  "screens": [
    {
      "id": "PERSONAL_SCREEN",
      "title": "Personal info",
      "terminal": false,
      "data": {
        "user_name": {
          "type": "string",
          "__example__": "Eze"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Hi ${data.user_name}! 👋 Let's set up your roommate profile.\n\n*Step 1 of 4* — Just a few personal details to start.",
            "markdown": true
          },
          {
            "type": "TextInput",
            "name": "first_name",
            "label": "First name",
            "helper-text": "e.g. Eze",
            "required": true,
            "max-chars": 50
          },
          {
            "type": "TextInput",
            "name": "last_name",
            "label": "Last name",
            "helper-text": "e.g. Okoro",
            "required": true,
            "max-chars": 50
          },
          {
            "type": "TextInput",
            "name": "email",
            "label": "Email address",
            "helper-text": "e.g. eze@email.com",
            "required": true,
            "input-type": "email",
            "max-chars": 150
          },
          {
            "type": "Dropdown",
            "name": "gender",
            "label": "Gender",
            "required": true,
            "data-source": [
              { "id": "male", "title": "Male" },
              { "id": "female", "title": "Female" }
            ]
          },
          {
            "type": "Dropdown",
            "name": "age_range",
            "label": "Age range",
            "required": true,
            "data-source": [
              { "id": "18-24", "title": "18 – 24" },
              { "id": "25-30", "title": "25 – 30" },
              { "id": "31-40", "title": "31 – 40" },
              { "id": "41-50", "title": "41 – 50" },
              { "id": "50+", "title": "50+" }
            ]
          },
          {
            "type": "Dropdown",
            "name": "marital_status",
            "label": "Marital status",
            "required": true,
            "data-source": [
              { "id": "single", "title": "Single" },
              { "id": "married", "title": "Married" },
              { "id": "divorced", "title": "Divorced" }
            ]
          },
          {
            "type": "Dropdown",
            "name": "religion",
            "label": "Religion",
            "required": true,
            "data-source": [
              { "id": "Christianity", "title": "Christianity" },
              { "id": "Islam", "title": "Islam" },
              { "id": "Others", "title": "Others" }
            ]
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "PREFERENCE_SCREEN"
              },
              "payload": {
                "user_name": "${data.user_name}",
                "first_name": "${form.first_name}",
                "last_name": "${form.last_name}",
                "email": "${form.email}",
                "gender": "${form.gender}",
                "age_range": "${form.age_range}",
                "marital_status": "${form.marital_status}",
                "religion": "${form.religion}"
              }
            }
          }
        ]
      }
